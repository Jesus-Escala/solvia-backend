# ---------------------------------------------------------------------------
# Solvia backend - environment variables
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=4000
# Public base URL of this API (used to build links to uploaded files and statements)
PUBLIC_API_URL=http://localhost:4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# IANA timezone used to evaluate due dates and schedule jobs
APP_TIMEZONE=America/Lima
# ISO 4217 currency code used in messages and statements
CURRENCY=PEN

# Database
DATABASE_URL=postgresql://solvia:solvia@localhost:5432/solvia?schema=public

# Authentication (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# File storage (payment proofs and generated statements)
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=5

# Scheduled jobs
JOBS_ENABLED=true
# Hourly reminder engine
REMINDER_CRON=0 * * * *
# Runs daily at 23:30; the job only generates the report on the last day of the month
MONTHLY_REPORT_CRON=30 23 * * *

# ---------------------------------------------------------------------------
# WhatsApp provider: mock | meta | dialog360 | twilio
# Only "mock" is implemented; the others are placeholders for future adapters.
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock
# Meta WhatsApp Cloud API
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION=v21.0
# 360dialog
# WHATSAPP_360DIALOG_API_KEY=
# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------------------------------------------------------------------------
# Payment provider: mock | culqi | mercadopago
# Only "mock" is implemented; the others are placeholders for future adapters.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
# Culqi
# CULQI_PUBLIC_KEY=
# CULQI_SECRET_KEY=
# Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=

# Seed the database with demo data on startup when it is empty (used by docker-compose)
SEED_ON_START=false

# ---------------------------------------------------------------------------
# Sign in with Google (optional). Create an OAuth "Web application" client in Google Cloud
# Console and add your web origin (e.g. http://localhost:5173) to "Authorized JavaScript origins".
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
