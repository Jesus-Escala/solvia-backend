// Solvia - Prisma schema
// Multi-tenant credit management and collections system.

generator client {
  provider      = "prisma-client-js"
  // "debian-openssl-3.0.x" is required by the node:22-slim Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantPlan {
  free
  starter
  pro
}

enum TenantStatus {
  active
  suspended
}

/// Optional modules a business can have enabled (from the backoffice). Debt collection is always on.
/// The product catalog is available when any of them is enabled.
enum TenantModule {
  /// Comercial: sales (cash or on credit) with their items.
  sales
  /// Logística: purchases from suppliers and stock.
  inventory
}

/// How a sale is paid: at the counter, or on credit (it creates the receivable).
enum SalePaymentType {
  cash
  credit
}

/// Receipt recorded with a sale (issued elsewhere; Solvia does not issue electronic receipts).
enum SaleDocType {
  none
  sale_note
  receipt
  invoice
}

enum SaleStatus {
  completed
  voided
}

/// Why a product's stock changed. `quantity` is signed: negative leaves, positive enters.
enum StockMovementType {
  sale
  sale_void
  purchase
  purchase_void
  adjustment
}

/// Why stock was adjusted by hand.
enum AdjustmentReason {
  /// Physical count: the stock is set to what was counted.
  count
  /// Lost, stolen or expired.
  loss
  /// Damaged, not sellable.
  damage
  /// Any other correction.
  correction
}

enum PurchaseStatus {
  completed
  voided
}

/// Unit a product is sold in.
enum ProductUnit {
  unit
  kg
  liter
  box
  pack
  dozen
  meter
}

enum UserRole {
  admin
  collector
}

enum ReceivableStatus {
  pending
  partial
  paid
  overdue
}

enum PaymentMethod {
  yape
  plin
  cash
  bank_transfer
}

enum MessageTemplateType {
  pre_due_reminder
  due_reminder
  overdue_reminder
  statement
}

enum NotificationChannel {
  whatsapp
}

enum NotificationStatus {
  sent
  failed
}

enum AccessRequestStatus {
  pending
  converted
  dismissed
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A business registered in Solvia. Every other tenant-owned record references it.
model Tenant {
  id        String         @id @default(uuid())
  name      String
  industry  String?
  plan      TenantPlan     @default(free)
  /// Suspended tenants cannot sign in or refresh their session.
  status    TenantStatus   @default(active)
  modules   TenantModule[] @default([])
  createdAt DateTime       @default(now())

  users            User[]
  customers        Customer[]
  receivables      Receivable[]
  messageTemplates MessageTemplate[]
  reminderSettings ReminderSettings?
  monthlyReports   MonthlyReport[]
  accessRequests   AccessRequest[]
  products         Product[]
  sales            Sale[]
  stockMovements   StockMovement[]
  suppliers        Supplier[]
  purchases        Purchase[]
  messagePacks     MessagePack[]

  @@map("tenants")
}

/// Extra automatic WhatsApp messages for one calendar month of a tenant (bought as packs).
model MessagePack {
  id        String   @id @default(uuid())
  tenantId  String
  /// First day of the month the messages are for (APP_TIMEZONE calendar).
  month     DateTime @db.Date
  messages  Int
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, month])
  @@map("message_packs")
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  email              String    @unique
  /// Null for accounts that only sign in with Google.
  passwordHash       String?
  /// Google account subject ("sub"), set when the user signs in with Google.
  googleId           String?   @unique
  role               UserRole  @default(collector)
  /// Inactive users cannot sign in or refresh their session.
  active             Boolean   @default(true)
  /// Set when the user received a temporary password; cleared by changing it.
  mustChangePassword Boolean   @default(false)
  /// Last successful password or Google sign-in.
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

/// A debtor of the tenant.
model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  /// E.164 format, including country code (e.g. +51987654321).
  phone      String
  /// Optional national ID / tax ID (DNI, RUC, etc.).
  documentId String?
  notes      String?
  createdAt  DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivables Receivable[]
  sales       Sale[]

  @@index([tenantId])
  @@index([tenantId, name])
  /// New customers per period (dashboard analytics).
  @@index([tenantId, createdAt])
  /// Trigram index: fast "name contains …" search in the customer picker (pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@map("customers")
}

/// A debt or invoice owed by a customer.
model Receivable {
  id          String           @id @default(uuid())
  tenantId    String
  customerId  String
  description String
  totalAmount Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  issueDate   DateTime         @db.Date
  dueDate     DateTime         @db.Date
  status      ReceivableStatus @default(pending)
  /// Set when the receivable comes from a sale on credit (its items are on the sale).
  saleId      String?          @unique
  createdAt   DateTime         @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments      Payment[]
  notifications Notification[]

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  /// Receivables issued per period (dashboard analytics).
  @@index([tenantId, issueDate])
  @@index([customerId])
  @@map("receivables")
}

model Payment {
  id           String        @id @default(uuid())
  receivableId String
  amount       Decimal       @db.Decimal(12, 2)
  date         DateTime      @db.Date
  method       PaymentMethod
  proofUrl     String?

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId])
  /// Payments per period (dashboard analytics, platform overview).
  @@index([date])
  @@map("payments")
}

/// WhatsApp message template. Supports placeholders such as {{name}}, {{amount}} and {{date}}.
model MessageTemplate {
  id       String              @id @default(uuid())
  tenantId String
  type     MessageTemplateType
  text     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@map("message_templates")
}

/// Log of every message send attempt.
model Notification {
  id           String               @id @default(uuid())
  receivableId String
  channel      NotificationChannel  @default(whatsapp)
  /// Template that produced the message; used to avoid duplicate reminders.
  templateType MessageTemplateType?
  status       NotificationStatus
  /// Sent by Solvia through the provider (counts against the plan's monthly messages). Manual
  /// reminders, sent from the owner's own WhatsApp, are false.
  automatic    Boolean              @default(false)
  sentAt       DateTime             @default(now())
  sentContent  String

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId, templateType, sentAt])
  @@map("notifications")
}

/// Per-tenant rules used by the automatic reminder engine.
model ReminderSettings {
  id               String  @id @default(uuid())
  tenantId         String  @unique
  enabled          Boolean @default(true)
  /// Send a pre-due reminder this many days before the due date (0 disables it).
  daysBeforeDue    Int     @default(3)
  /// Send a reminder on the due date.
  onDueDate        Boolean @default(true)
  /// While unpaid, send an overdue reminder every N days after the due date (0 disables it).
  overdueEveryDays Int     @default(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reminder_settings")
}

/// Month-end collections summary generated by a scheduled job.
model MonthlyReport {
  id                  String   @id @default(uuid())
  tenantId            String
  /// Reporting period in YYYY-MM format.
  period              String
  totalCollected      Decimal  @db.Decimal(14, 2)
  totalPending        Decimal  @db.Decimal(14, 2)
  /// Top 5 overdue customers: [{ customerId, name, overdueAmount, overdueCount }]
  topOverdueCustomers Json
  generatedAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("monthly_reports")
}

/// Solvia staff account with access to the platform backoffice (all tenants). Not tenant-owned.
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@map("platform_admins")
}

/// "Request access" submission from the landing page. Not tenant-owned: it exists before the
/// business does, and points to the tenant created from it once converted.
model AccessRequest {
  id           String              @id @default(uuid())
  businessName String
  contactName  String
  email        String
  phone        String
  industry     String?
  message      String?
  /// Optional modules the business is interested in (checked on the landing form).
  modules      TenantModule[]      @default([])
  status       AccessRequestStatus @default(pending)
  /// Tenant created from this request (set when converted).
  tenantId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("access_requests")
}

/// An item of the business catalog (what it sells or buys). Stock comes with the inventory module.
model Product {
  id         String      @id @default(uuid())
  tenantId   String
  name       String
  /// Optional barcode or internal code, unique within the business.
  code       String?
  unit       ProductUnit @default(unit)
  price      Decimal     @db.Decimal(12, 2)
  cost       Decimal?    @db.Decimal(12, 2)
  /// Whether sales and purchases move its stock (false for services or bulk items not counted).
  trackStock Boolean     @default(true)
  minStock   Decimal?    @db.Decimal(12, 3)
  /// Current stock, kept in step with the StockMovement ledger (can go negative).
  stock      Decimal     @default(0) @db.Decimal(12, 3)
  /// Archived products stay for history but are hidden from pickers.
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, active, name])
  /// Trigram index: fast "name contains …" search in the product picker (pg_trgm).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

/// A sale with its items. Cash sales are paid at the counter; credit sales create a receivable.
model Sale {
  id          String          @id @default(uuid())
  tenantId    String
  /// Sequential per business ("Venta #12").
  number      Int
  /// Optional for cash sales (walk-in customer); required for credit sales.
  customerId  String?
  date        DateTime        @db.Date
  paymentType SalePaymentType
  /// How a cash sale was paid.
  method      PaymentMethod?
  docType     SaleDocType     @default(none)
  docNumber   String?
  total       Decimal         @db.Decimal(12, 2)
  /// Some counted product was sold beyond its stock (see SaleItem.shortage) — traceability.
  hasShortage Boolean         @default(false)
  status      SaleStatus      @default(completed)
  createdById String?
  createdAt   DateTime        @default(now())
  voidedAt    DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      SaleItem[]
  receivable Receivable?
  movements  StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, hasShortage])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  /// Order in which the line was added.
  position    Int     @default(0)
  /// Product name at the time of the sale (the product may be renamed later).
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  /// Quantity sold beyond the stock available at that moment (0 when there was enough).
  shortage    Decimal @default(0) @db.Decimal(12, 3)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

/// Ledger of every stock change; Product.stock is its running total.
model StockMovement {
  id           String            @id @default(uuid())
  tenantId     String
  productId    String
  type         StockMovementType
  /// Signed: negative leaves (sale), positive enters (purchase, void).
  quantity     Decimal           @db.Decimal(12, 3)
  /// Stock the product was left with after this movement (null for rows recorded before it existed).
  balanceAfter Decimal?          @db.Decimal(12, 3)
  /// Part of the quantity that left without stock to cover it (traceability of differences).
  shortage     Decimal           @default(0) @db.Decimal(12, 3)
  saleId       String?
  purchaseId   String?
  /// For manual adjustments.
  reason       AdjustmentReason?
  note         String?
  createdById  String?
  createdAt    DateTime          @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId, createdAt])
  @@map("stock_movements")
}

/// Who the business buys from (inventory module).
model Supplier {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  /// RUC or DNI (optional).
  documentId String?
  /// E.164 WhatsApp number (optional).
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([tenantId, name])
  @@map("suppliers")
}

/// Goods bought (inventory module): counted products enter stock.
model Purchase {
  id          String         @id @default(uuid())
  tenantId    String
  /// Sequential per business ("Compra #7").
  number      Int
  supplierId  String?
  date        DateTime       @db.Date
  docType     SaleDocType    @default(none)
  docNumber   String?
  total       Decimal        @db.Decimal(12, 2)
  status      PurchaseStatus @default(completed)
  createdById String?
  createdAt   DateTime       @default(now())
  voidedAt    DateTime?

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  movements StockMovement[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@map("purchases")
}

model PurchaseItem {
  id          String  @id @default(uuid())
  purchaseId  String
  productId   String
  position    Int     @default(0)
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}
