// Solvia - Prisma schema
// Multi-tenant credit management and collections system.

generator client {
  provider      = "prisma-client-js"
  // "debian-openssl-3.0.x" is required by the node:22-slim Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantPlan {
  free
  starter
  pro
}

enum TenantStatus {
  active
  suspended
}

enum UserRole {
  admin
  collector
}

enum ReceivableStatus {
  pending
  partial
  paid
  overdue
}

enum PaymentMethod {
  yape
  plin
  cash
  bank_transfer
}

enum MessageTemplateType {
  pre_due_reminder
  due_reminder
  overdue_reminder
  statement
}

enum NotificationChannel {
  whatsapp
}

enum NotificationStatus {
  sent
  failed
}

enum AccessRequestStatus {
  pending
  converted
  dismissed
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A business registered in Solvia. Every other tenant-owned record references it.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  industry  String?
  plan      TenantPlan   @default(free)
  /// Suspended tenants cannot sign in or refresh their session.
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now())

  users            User[]
  customers        Customer[]
  receivables      Receivable[]
  messageTemplates MessageTemplate[]
  reminderSettings ReminderSettings?
  monthlyReports   MonthlyReport[]
  accessRequests   AccessRequest[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  email              String    @unique
  /// Null for accounts that only sign in with Google.
  passwordHash       String?
  /// Google account subject ("sub"), set when the user signs in with Google.
  googleId           String?   @unique
  role               UserRole  @default(collector)
  /// Inactive users cannot sign in or refresh their session.
  active             Boolean   @default(true)
  /// Set when the user received a temporary password; cleared by changing it.
  mustChangePassword Boolean   @default(false)
  /// Last successful password or Google sign-in.
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

/// A debtor of the tenant.
model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  /// E.164 format, including country code (e.g. +51987654321).
  phone      String
  /// Optional national ID / tax ID (DNI, RUC, etc.).
  documentId String?
  notes      String?
  createdAt  DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivables Receivable[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("customers")
}

/// A debt or invoice owed by a customer.
model Receivable {
  id          String           @id @default(uuid())
  tenantId    String
  customerId  String
  description String
  totalAmount Decimal          @db.Decimal(12, 2)
  paidAmount  Decimal          @default(0) @db.Decimal(12, 2)
  issueDate   DateTime         @db.Date
  dueDate     DateTime         @db.Date
  status      ReceivableStatus @default(pending)
  createdAt   DateTime         @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments      Payment[]
  notifications Notification[]

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([customerId])
  @@map("receivables")
}

model Payment {
  id           String        @id @default(uuid())
  receivableId String
  amount       Decimal       @db.Decimal(12, 2)
  date         DateTime      @db.Date
  method       PaymentMethod
  proofUrl     String?

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId])
  @@map("payments")
}

/// WhatsApp message template. Supports placeholders such as {{name}}, {{amount}} and {{date}}.
model MessageTemplate {
  id       String              @id @default(uuid())
  tenantId String
  type     MessageTemplateType
  text     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@map("message_templates")
}

/// Log of every message send attempt.
model Notification {
  id           String               @id @default(uuid())
  receivableId String
  channel      NotificationChannel  @default(whatsapp)
  /// Template that produced the message; used to avoid duplicate reminders.
  templateType MessageTemplateType?
  status       NotificationStatus
  sentAt       DateTime             @default(now())
  sentContent  String

  receivable Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@index([receivableId, templateType, sentAt])
  @@map("notifications")
}

/// Per-tenant rules used by the automatic reminder engine.
model ReminderSettings {
  id               String  @id @default(uuid())
  tenantId         String  @unique
  enabled          Boolean @default(true)
  /// Send a pre-due reminder this many days before the due date (0 disables it).
  daysBeforeDue    Int     @default(3)
  /// Send a reminder on the due date.
  onDueDate        Boolean @default(true)
  /// While unpaid, send an overdue reminder every N days after the due date (0 disables it).
  overdueEveryDays Int     @default(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("reminder_settings")
}

/// Month-end collections summary generated by a scheduled job.
model MonthlyReport {
  id                  String   @id @default(uuid())
  tenantId            String
  /// Reporting period in YYYY-MM format.
  period              String
  totalCollected      Decimal  @db.Decimal(14, 2)
  totalPending        Decimal  @db.Decimal(14, 2)
  /// Top 5 overdue customers: [{ customerId, name, overdueAmount, overdueCount }]
  topOverdueCustomers Json
  generatedAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@map("monthly_reports")
}

/// Solvia staff account with access to the platform backoffice (all tenants). Not tenant-owned.
model PlatformAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@map("platform_admins")
}

/// "Request access" submission from the landing page. Not tenant-owned: it exists before the
/// business does, and points to the tenant created from it once converted.
model AccessRequest {
  id           String              @id @default(uuid())
  businessName String
  contactName  String
  email        String
  phone        String
  industry     String?
  message      String?
  status       AccessRequestStatus @default(pending)
  /// Tenant created from this request (set when converted).
  tenantId     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@map("access_requests")
}
